{
  "version": 2,
  "builds": [
    {
      "src": "api/content.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/content",
      "dest": "api/content.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
